{
  "name": "markdesk",
  "productName": "MarkDesk",
  "version": "0.6.2",
  "private": true,
  "description": "A secure single-file Markdown reader and editor",
  "scripts": {
    "dev": "tauri dev",
    "dev:renderer": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "smoke": "node tests/tauri/smoke.mjs",
    "dist": "tauri build && node scripts/rename-bundle.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.3.1",
    "@codemirror/language-data": "6.0.0",
    "@codemirror/state": "6.7.6",
    "@tauri-apps/api": "^2.12.4",
    "codemirror": "6.0.1",
    "dompurify": "3.2.3",
    "markdown-it": "14.1.0",
    "markdown-it-task-lists": "2.1.1",
    "mermaid": "11.12.0",
    "prosemirror-commands": "1.6.2",
    "prosemirror-dropcursor": "1.8.1",
    "prosemirror-gapcursor": "1.3.1",
    "prosemirror-history": "1.4.1",
    "prosemirror-inputrules": "1.4.0",
    "prosemirror-keymap": "1.2.2",
    "prosemirror-markdown": "1.13.0",
    "prosemirror-model": "1.23.0",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.3",
    "prosemirror-transform": "1.10.2",
    "prosemirror-view": "1.34.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/markdown-it": "14.1.2",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "^26.0.0",
    "typescript": "5.7.2",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "allowScripts": {
    "electron@33.2.0": true,
    "esbuild@0.21.5": true
  },
  "author": "MarkDesk contributors"
}
