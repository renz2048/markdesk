{
  "name": "markdesk",
  "productName": "MarkDesk",
  "version": "0.1.0",
  "private": true,
  "description": "A secure single-file Markdown reader and editor",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && tsc -p tsconfig.electron.json && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && playwright test",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.3.1",
    "@codemirror/language-data": "6.0.1",
    "@codemirror/state": "6.5.2",
    "codemirror": "6.0.1",
    "dompurify": "3.2.3",
    "electron": "33.2.0",
    "electron-builder": "25.1.8",
    "markdown-it": "14.1.0",
    "markdown-it-task-lists": "2.1.1",
    "prosemirror-commands": "1.6.2",
    "prosemirror-dropcursor": "1.8.1",
    "prosemirror-gapcursor": "1.3.1",
    "prosemirror-history": "1.4.1",
    "prosemirror-inputrules": "1.4.0",
    "prosemirror-keymap": "1.2.2",
    "prosemirror-markdown": "1.13.0",
    "prosemirror-model": "1.23.0",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.3",
    "prosemirror-transform": "1.10.2",
    "prosemirror-view": "1.34.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@types/markdown-it": "14.1.2",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "@playwright/test": "1.49.1",
    "concurrently": "9.1.0",
    "cross-env": "7.0.3",
    "typescript": "5.7.2",
    "vite": "5.4.11",
    "vitest": "2.1.8",
    "wait-on": "8.0.1"
  }
}
